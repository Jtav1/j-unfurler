# HTTP port
PORT=3003

# Per-site unfurler toggles. All default to enabled; set to "false" to disable a route at startup.
ENABLE_REDDIT=true
ENABLE_FACEBOOK=true
ENABLE_TWITTER=true
ENABLE_INSTAGRAM=true
ENABLE_TIKTOK=true
ENABLE_BSKY=true

# Number of reverse-proxy hops in front of this service (1 = Nginx Proxy Manager directly in
# front). The client IP used for rate limiting is read from X-Forwarded-For based on this.
# Never set this to "true". May also be a CIDR/IP list, e.g. "172.18.0.0/16".
TRUST_PROXY=1

# Per-client-IP rate limit on /api/*: RATE_LIMIT_MAX requests per RATE_LIMIT_WINDOW_SECONDS.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=30

# Hard cap on simultaneous outbound unfurls across all callers; requests beyond it get a 503.
MAX_CONCURRENT_UNFURLS=32

# Response cache. Successful unfurls are cached for CACHE_TTL_SECONDS; structured failures
# (login walls, upstream 4xx/5xx) for CACHE_ERROR_TTL_SECONDS. CACHE_MAX_ENTRIES only applies
# to the in-memory backend.
CACHE_TTL_SECONDS=600
CACHE_ERROR_TTL_SECONDS=60
CACHE_MAX_ENTRIES=1000

# Optional: use an external redis for the cache and rate-limit counters (shared across replicas).
# Leave empty to use in-process memory.
REDIS_URL=
# REDIS_URL=redis://redis:6379

# Optional: comma-separated browser origins allowed to call the API. Empty = no CORS headers.
CORS_ORIGINS=
